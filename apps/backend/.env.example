NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://dashify_app:local_dev_password@localhost:5433/dashify?schema=public
DIRECT_URL=postgresql://dashify_migrator:local_migrate_password@localhost:5433/dashify?schema=public
APP_BASE_URL=http://localhost:3000
WEB_APP_ORIGIN=http://localhost:3000
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=debug
STORAGE_PROVIDER=local
STORAGE_BUCKET=dashify-private
STORAGE_LOCAL_DIR=./var/private-files
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
SCHOOL_ADMIN_DEFAULT_PASSWORD=
# Optional local sign-in shortcut for an existing School Admin account.
SCHOOL_ADMIN_EMAIL=
