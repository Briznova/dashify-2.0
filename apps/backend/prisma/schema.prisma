generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
  OPEN
  CLOSED
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TeacherAssessmentType {
  ASSIGNMENT
  EXAM
  TEST
}

enum TeacherAssessmentStatus {
  DRAFT
  PUBLISHED
}

enum AuthScope {
  PLATFORM
  SCHOOL_SELECTION
  SCHOOL
}

enum SchoolOnboardingStatus {
  NOT_STARTED
  COMPLETED
}

enum PlatformPermission {
  SCHOOLS_CREATE
  SCHOOL_ADMINS_CREATE
  AUDIT_READ
  SETTINGS_READ
  SUPPORT_READ
  SUPPORT_UPDATE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  GENERAL
  ATTENDANCE
  FEE
  ANNOUNCEMENT
  SYSTEM
}

enum FilePurpose {
  STUDENT_DOCUMENT
  PROFILE_IMAGE
  OTHER
}

model School {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String
  code               String                  @unique
  email              String?
  phone              String?
  address            Json?
  timezone           String                  @default("Asia/Kolkata")
  locale             String                  @default("en-IN")
  currency           String                  @default("INR")
  admissionPrefix    String?                 @map("admission_prefix")
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  memberships        SchoolMembership[]
  academicYears      AcademicYear[]
  gradeScales        GradeScale[]
  classes            SchoolClass[]
  staff              StaffProfile[]
  departments        SchoolDepartment[]
  teacherAssignments TeacherAssignment[]
  teacherAssessments TeacherAssessment[]
  teacherResults     TeacherResult[]
  students           Student[]
  guardians          Guardian[]
  attendanceSessions AttendanceSession[]
  announcements      Announcement[]
  auditLogs          AuditLog[]
  fileObjects        FileObject[]
  admissionSequences AdmissionSequence[]
  onboardingState    SchoolOnboardingState?
  supportTickets     PlatformSupportTicket[]

  @@map("schools")
}

model AdmissionSequence {
  schoolId  String @map("school_id") @db.Uuid
  year      Int
  lastValue Int    @default(0) @map("last_value")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@id([schoolId, year])
  @@map("admission_sequences")
}

model User {
  id                     String                       @id @default(uuid()) @db.Uuid
  email                  String                       @unique
  passwordHash           String                       @map("password_hash")
  firstName              String                       @map("first_name")
  lastName               String?                      @map("last_name")
  phone                  String?
  isActive               Boolean                      @default(true) @map("is_active")
  emailVerifiedAt        DateTime?                    @map("email_verified_at")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  memberships            SchoolMembership[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  notifications          Notification[]
  platformAdminGrant     PlatformAdminGrant?
  createdSupportTickets  PlatformSupportTicket[]      @relation("SupportTicketCreator")
  assignedSupportTickets PlatformSupportTicket[]      @relation("SupportTicketAssignee")
  supportTicketEvents    PlatformSupportTicketEvent[]

  @@map("users")
}

model SchoolMembership {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  joinedAt  DateTime?        @map("joined_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles     MembershipRole[]

  @@unique([schoolId, userId])
  @@index([userId, status])
  @@map("school_memberships")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String?          @map("school_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([schoolId, key])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String           @map("membership_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  membership   SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model PlatformAdminGrant {
  id          String                         @id @default(uuid()) @db.Uuid
  userId      String                         @unique @map("user_id") @db.Uuid
  grantedAt   DateTime                       @default(now()) @map("granted_at")
  revokedAt   DateTime?                      @map("revoked_at")
  user        User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  permissions PlatformAdminGrantPermission[]

  @@index([revokedAt])
  @@map("platform_admin_grants")
}

model PlatformAdminGrantPermission {
  id         String             @id @default(uuid()) @db.Uuid
  grantId    String             @map("grant_id") @db.Uuid
  permission PlatformPermission
  grantedAt  DateTime           @default(now()) @map("granted_at")
  revokedAt  DateTime?          @map("revoked_at")
  grant      PlatformAdminGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([grantId, permission])
  @@index([revokedAt])
  @@map("platform_admin_grant_permissions")
}

model SchoolOnboardingState {
  id        String                 @id @default(uuid()) @db.Uuid
  schoolId  String                 @unique @map("school_id") @db.Uuid
  status    SchoolOnboardingStatus @default(NOT_STARTED)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("school_onboarding_states")
}

model PlatformSupportTicket {
  id          String                       @id @default(uuid()) @db.Uuid
  schoolId    String                       @map("school_id") @db.Uuid
  title       String                       @db.VarChar(120)
  description String                       @db.VarChar(4000)
  status      SupportTicketStatus          @default(OPEN)
  priority    SupportTicketPriority        @default(NORMAL)
  createdById String                       @map("created_by_id") @db.Uuid
  assigneeId  String?                      @map("assignee_id") @db.Uuid
  version     Int                          @default(1)
  resolvedAt  DateTime?                    @map("resolved_at")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")
  school      School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy   User                         @relation("SupportTicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee    User?                        @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  events      PlatformSupportTicketEvent[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, resolvedAt])
  @@map("platform_support_tickets")
}

model PlatformSupportTicketEvent {
  id          String                @id @default(uuid()) @db.Uuid
  ticketId    String                @map("ticket_id") @db.Uuid
  actorUserId String                @map("actor_user_id") @db.Uuid
  action      String                @db.VarChar(32)
  fromValue   String?               @map("from_value") @db.VarChar(64)
  toValue     String?               @map("to_value") @db.VarChar(64)
  createdAt   DateTime              @default(now()) @map("created_at")
  ticket      PlatformSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor       User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("platform_support_ticket_events")
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedById        String?   @map("replaced_by_id") @db.Uuid
  sessionId           String?   @map("session_id") @db.Uuid
  activeSchoolId      String?   @map("active_school_id") @db.Uuid
  membershipId        String?   @map("membership_id") @db.Uuid
  activeWorkspaceRole String?   @map("active_workspace_role")
  scope               AuthScope @default(SCHOOL_SELECTION)
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId, revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AcademicYear {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  name               String
  startDate          DateTime            @map("start_date") @db.Date
  endDate            DateTime            @map("end_date") @db.Date
  status             AcademicYearStatus  @default(DRAFT)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrolments         StudentEnrolment[]
  gradeScale         GradeScale?
  teacherAssessments TeacherAssessment[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@map("academic_years")
}

model SchoolClass {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  name               String
  code               String
  sortOrder          Int                 @default(0) @map("sort_order")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sections           Section[]
  attendanceSessions AttendanceSession[]
  teacherAssignments TeacherAssignment[]
  teacherAssessments TeacherAssessment[]
  announcements      Announcement[]

  @@unique([schoolId, code])
  @@index([schoolId, sortOrder])
  @@map("classes")
}

model Section {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  classId            String              @map("class_id") @db.Uuid
  name               String
  code               String
  capacity           Int?
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  class              SchoolClass         @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrolments         StudentEnrolment[]
  attendanceSessions AttendanceSession[]
  teacherAssignments TeacherAssignment[]
  teacherAssessments TeacherAssessment[]
  announcements      Announcement[]

  @@unique([classId, code])
  @@index([schoolId, classId])
  @@map("sections")
}

model StaffProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  userId             String?             @map("user_id") @db.Uuid
  firstName          String?             @map("first_name")
  lastName           String?             @map("last_name")
  email              String?             @map("email")
  phone              String?             @map("phone")
  employeeCode       String?             @map("employee_code")
  designation        String?
  department         String?
  departmentId       String?             @map("department_id") @db.Uuid
  joinedAt           DateTime?           @map("joined_at")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  departmentRecord   SchoolDepartment?   @relation(fields: [schoolId, departmentId], references: [schoolId, id], onDelete: Restrict)
  teacherAssignments TeacherAssignment[]
  teacherAssessments TeacherAssessment[]

  @@unique([schoolId, userId])
  @@unique([schoolId, employeeCode])
  @@index([schoolId, isActive])
  @@map("staff_profiles")
}

model SchoolDepartment {
  id        String         @id @default(uuid()) @db.Uuid
  schoolId  String         @map("school_id") @db.Uuid
  name      String
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff     StaffProfile[]

  @@unique([schoolId, id])
  @@index([schoolId, isActive])
  @@map("school_departments")
}

model TeacherAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  staffId        String       @map("staff_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  sectionId      String?      @map("section_id") @db.Uuid
  subject        String?
  isClassTeacher Boolean      @default(false) @map("is_class_teacher")
  isActive       Boolean      @default(true) @map("is_active")
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff          StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)
  class          SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  section        Section?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([schoolId, staffId, classId, sectionId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, staffId, isActive])
  @@map("teacher_assignments")
}

model Student {
  id                    String             @id @default(uuid()) @db.Uuid
  schoolId              String             @map("school_id") @db.Uuid
  admissionNumber       String             @map("admission_number")
  firstName             String             @map("first_name")
  middleName            String?            @map("middle_name")
  lastName              String?            @map("last_name")
  dateOfBirth           DateTime?          @map("date_of_birth") @db.Date
  gender                Gender?
  admissionDate         DateTime           @map("admission_date") @db.Date
  status                RecordStatus       @default(ACTIVE)
  archivedAt            DateTime?          @map("archived_at")
  address               Json?
  emergencyContactKind  String?            @map("emergency_contact_kind")
  emergencyContactName  String?            @map("emergency_contact_name")
  emergencyContactPhone String?            @map("emergency_contact_phone")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  school                School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  guardians             StudentGuardian[]
  enrolments            StudentEnrolment[]
  attendanceRecords     AttendanceRecord[]
  teacherResults        TeacherResult[]
  fileObjects           FileObject[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status, lastName, firstName])
  @@map("students")
}

model Guardian {
  id        String            @id @default(uuid()) @db.Uuid
  schoolId  String            @map("school_id") @db.Uuid
  firstName String            @map("first_name")
  lastName  String?           @map("last_name")
  phone     String
  email     String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  students  StudentGuardian[]

  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  schoolId     String               @map("school_id") @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  guardianId   String               @map("guardian_id") @db.Uuid
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false) @map("is_primary")
  canPickup    Boolean              @default(false) @map("can_pickup")
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([studentId, guardianId])
  @@index([schoolId, guardianId])
  @@map("student_guardians")
}

model StudentEnrolment {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  sectionId      String       @map("section_id") @db.Uuid
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  isActive       Boolean      @default(true) @map("is_active")
  rollNumber     String?      @map("roll_number")
  createdAt      DateTime     @default(now()) @map("created_at")
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([schoolId, academicYearId, classId, sectionId])
  @@index([schoolId, studentId, isActive])
  @@map("student_enrolments")
}

model AttendanceSession {
  id          String                  @id @default(uuid()) @db.Uuid
  schoolId    String                  @map("school_id") @db.Uuid
  classId     String                  @map("class_id") @db.Uuid
  sectionId   String                  @map("section_id") @db.Uuid
  date        DateTime                @db.Date
  status      AttendanceSessionStatus @default(OPEN)
  createdBy   String                  @map("created_by") @db.Uuid
  closedAt    DateTime?               @map("closed_at")
  submittedAt DateTime?               @map("submitted_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  school      School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class       SchoolClass             @relation(fields: [classId], references: [id], onDelete: Restrict)
  section     Section                 @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  records     AttendanceRecord[]

  @@unique([schoolId, date, classId, sectionId])
  @@index([schoolId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid()) @db.Uuid
  schoolId  String            @map("school_id") @db.Uuid
  sessionId String            @map("session_id") @db.Uuid
  studentId String            @map("student_id") @db.Uuid
  status    AttendanceStatus
  remarks   String?
  markedBy  String            @map("marked_by") @db.Uuid
  markedAt  DateTime          @default(now()) @map("marked_at")
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId, markedAt])
  @@map("attendance_records")
}

model TeacherAssessment {
  id                 String                  @id @default(uuid()) @db.Uuid
  schoolId           String                  @map("school_id") @db.Uuid
  staffId            String                  @map("staff_id") @db.Uuid
  classId            String                  @map("class_id") @db.Uuid
  sectionId          String                  @map("section_id") @db.Uuid
  academicYearId     String?                 @map("academic_year_id") @db.Uuid
  type               TeacherAssessmentType
  status             TeacherAssessmentStatus @default(DRAFT)
  title              String
  description        String?
  dueDate            DateTime                @map("due_date") @db.Date
  startTime          String?                 @map("start_time")
  durationMinutes    Int?                    @map("duration_minutes")
  maxScore           Int                     @map("max_score")
  passMark           Int?                    @map("pass_mark")
  createdBy          String                  @map("created_by") @db.Uuid
  publishedAt        DateTime?               @map("published_at")
  resultsPublishedAt DateTime?               @map("results_published_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff              StaffProfile            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  class              SchoolClass             @relation(fields: [classId], references: [id], onDelete: Restrict)
  section            Section                 @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  academicYear       AcademicYear?           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  results            TeacherResult[]

  @@index([schoolId, staffId, status, dueDate])
  @@index([schoolId, classId, sectionId, dueDate])
  @@index([schoolId, academicYearId, dueDate])
  @@map("teacher_assessments")
}

model GradeScale {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @unique @map("academic_year_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  bands          GradeBand[]

  @@index([schoolId])
  @@map("grade_scales")
}

model GradeBand {
  id         String     @id @default(uuid()) @db.Uuid
  scaleId    String     @map("scale_id") @db.Uuid
  label      String     @db.VarChar(20)
  minPercent Int        @map("min_percent")
  maxPercent Int        @map("max_percent")
  sortOrder  Int        @default(0) @map("sort_order")
  scale      GradeScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, label])
  @@index([scaleId, sortOrder])
  @@map("grade_bands")
}

model TeacherResult {
  id           String            @id @default(uuid()) @db.Uuid
  schoolId     String            @map("school_id") @db.Uuid
  assessmentId String            @map("assessment_id") @db.Uuid
  studentId    String            @map("student_id") @db.Uuid
  score        Int
  feedback     String?
  updatedBy    String            @map("updated_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  assessment   TeacherAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, studentId])
  @@index([schoolId, assessmentId])
  @@index([schoolId, studentId, updatedAt])
  @@map("teacher_results")
}

model Announcement {
  id            String             @id @default(uuid()) @db.Uuid
  schoolId      String             @map("school_id") @db.Uuid
  sectionId     String?            @map("section_id") @db.Uuid
  category      String?
  title         String
  body          String
  status        AnnouncementStatus @default(DRAFT)
  audience      Json?
  publishedAt   DateTime?          @map("published_at")
  createdBy     String             @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  school        School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  section       Section?           @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  schoolClass   SchoolClass?       @relation(fields: [schoolClassId], references: [id])
  schoolClassId String?            @db.Uuid

  @@index([schoolId, status, publishedAt])
  @@index([schoolId, sectionId, status, createdAt])
  @@map("announcements")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  schoolId  String?          @map("school_id") @db.Uuid
  type      NotificationType @default(GENERAL)
  title     String
  body      String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model FileObject {
  id           String      @id @default(uuid()) @db.Uuid
  schoolId     String      @map("school_id") @db.Uuid
  studentId    String?     @map("student_id") @db.Uuid
  purpose      FilePurpose
  objectKey    String      @unique @map("object_key")
  originalName String      @map("original_name")
  mimeType     String      @map("mime_type")
  sizeBytes    BigInt      @map("size_bytes")
  checksum     String?
  uploadedBy   String      @map("uploaded_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student      Student?    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([schoolId, studentId])
  @@map("file_objects")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  requestId   String?  @map("request_id")
  summary     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
